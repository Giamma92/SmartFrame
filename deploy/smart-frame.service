# ---------------------------------------------------------------------
#  Servizio systemd per il backend Smart Frame
#
#  Installazione automatica:  ./deploy/install.sh
#  Installazione manuale (sostituisci utente/percorsi se diversi):
#    sudo cp deploy/smart-frame.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now smart-frame
#  Log in tempo reale:        journalctl -u smart-frame -f
# ---------------------------------------------------------------------
[Unit]
Description=Smart Frame & Calendar (Node.js backend)
# Parte quando la rete è pronta (serve per Google Calendar e meteo)
After=network-online.target
Wants=network-online.target
# Se va in crash più di 10 volte in 5 minuti smette di riprovare (evita loop infiniti)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smart-frame
ExecStart=/usr/bin/node server/server.js
Environment=NODE_ENV=production
# Riavvio automatico in caso di crash (o uscita con errore)
Restart=always
RestartSec=5
# Limiti prudenti per il Raspberry
MemoryMax=512M
Nice=5

[Install]
WantedBy=multi-user.target
