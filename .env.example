# =====================================================================
#  Smart Frame & Calendar - configurazione
#  Copia questo file in ".env" e modifica i valori che ti servono.
#  Tutte le variabili sono opzionali: se mancano si usano i default.
# =====================================================================

# ---------- Server ----------
PORT=3000
# 0.0.0.0 = raggiungibile da tutta la LAN, 127.0.0.1 = solo dal Raspberry
HOST=0.0.0.0
# Fuso orario usato per calcolare "oggi" (consigliato impostarlo)
TZ=Europe/Rome

# ---------- Google Calendar ----------
# File OAuth scaricato da Google Cloud Console (client di tipo "App desktop")
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Dove viene salvato il token dopo l'autorizzazione (/auth)
GOOGLE_TOKEN_PATH=./data/token.json
# Deve puntare a localhost: apri /auth dal browser del Raspberry o tramite tunnel SSH
OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
# Elenco di calendari separati da virgola: "primary", ID specifici
# (es. famiglia@group.calendar.google.com) oppure "all" per tutti quelli visibili
CALENDAR_IDS=primary
# Quanti giorni in avanti mostrare (0 = solo oggi)
CALENDAR_DAYS_AHEAD=7
# Numero massimo di eventi visualizzati
CALENDAR_MAX_EVENTS=10
# Ogni quanti minuti interrogare Google Calendar
CALENDAR_REFRESH_MIN=5
# Permetti /auth anche da IP non locali (sconsigliato)
ALLOW_REMOTE_AUTH=false

# ---------- Meteo (Open-Meteo, gratuito, senza API key) ----------
# Trova le coordinate su https://www.latlong.net/ o Google Maps
WEATHER_LAT=41.9028
WEATHER_LON=12.4964
WEATHER_LOCATION_NAME=Roma
WEATHER_REFRESH_MIN=10

# ---------- Foto ----------
# Cartella locale con le immagini (sincronizzata con Syncthing, rclone, Samba...)
PHOTOS_DIR=./photos
PHOTOS_RECURSIVE=true
PHOTOS_RESCAN_MIN=10
# Ridimensionamento automatico (richiede il pacchetto "sharp"): alleggerisce molto il Pi.
# Per TV 4K usa 3840x2160, per 1080p 1920x1080.
PHOTOS_RESIZE=true
PHOTOS_MAX_WIDTH=1920
PHOTOS_MAX_HEIGHT=1080
PHOTOS_CACHE_DIR=./data/cache

# ---------- Display / Frontend ----------
LOCALE=it-IT
SLIDE_INTERVAL_SEC=60
FADE_SEC=3
SHUFFLE=true
# Effetto Ken Burns (zoom/pan lento). Disattivalo su Pi 3 / Zero 2 se scatta.
KEN_BURNS=true
# Sfocatura (backdrop-filter) dei pannelli. Disattivala se la GPU fatica.
PANEL_BLUR=true
SHOW_SECONDS=false
# Ogni quanti secondi il frontend richiede /api/data
CLIENT_REFRESH_SEC=60
# Sposta leggermente i pannelli ogni pochi minuti (anti burn-in TV OLED/plasma)
PIXEL_SHIFT=true
# Oscuramento notturno dello schermo (level: 0 = nessuno, 1 = nero)
NIGHT_DIM=true
NIGHT_DIM_START=23:00
NIGHT_DIM_END=07:00
NIGHT_DIM_LEVEL=0.7
